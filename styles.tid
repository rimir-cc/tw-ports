title: $:/plugins/rimir/ports/styles
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/* ---------- handle (on the right border of .tc-tiddler-frame) ---------- */

.ports-anchor {
	height: 0;
}

.ports-handle {
	position: absolute;
	right: -8px;
	z-index: 5;
	display: inline-flex;
	align-items: center;
	cursor: pointer;
	opacity: 0;
	transition: opacity 0.18s ease;
}

.ports-handle--tiddler {
	top: 40px;
}

.ports-ring {
	width: 14px;
	height: 14px;
	border-radius: 50%;
	box-sizing: border-box;
	background: <<colour tiddler-background>>;
	border: 1.5px solid <<colour muted-foreground>>;
	box-shadow: 0 0 0 3px <<colour tiddler-background>>;
	transition: transform 0.15s, border-color 0.15s, background-color 0.15s;
}

.ports-handle.has-links .ports-ring {
	background: <<colour primary>>;
	border-color: <<colour primary>>;
}

.ports-count {
	position: absolute;
	left: 18px;
	top: 50%;
	transform: translateY(-50%);
	font-size: 10.5px;
	line-height: 1;
	color: <<colour muted-foreground>>;
	font-variant-numeric: tabular-nums;
	pointer-events: none;
}

.ports-handle:hover .ports-ring,
.ports-handle:focus-visible .ports-ring,
.ports-handle.is-open .ports-ring {
	transform: scale(1.2);
	border-color: <<colour primary>>;
}

.tc-tiddler-frame:hover .ports-handle--tiddler,
.ports-handle:focus-visible,
.ports-handle.is-open {
	opacity: 1;
}

.ports-dragging .ports-handle:not(.is-open) {
	opacity: 0;
}

@media (hover: none) {
	.ports-handle {
		opacity: 0.6;
	}
}

/* ---------- flyout ---------- */

.ports-flyout {
	position: fixed;
	z-index: 1050;
	box-sizing: border-box;
	width: 268px;
	max-width: calc(100vw - 24px);
	padding: 6px;
	border-radius: 10px;
	border: 1px solid <<colour tiddler-border>>;
	background: <<colour tiddler-background>>;
	color: <<colour foreground>>;
	box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
	font-size: 13.5px;
	line-height: 1.4;
	animation: ports-fly-in 0.16s ease-out;
}

.ports-flyout--left {
	animation-name: ports-fly-in-left;
}

@keyframes ports-fly-in {
	from { opacity: 0; transform: translateX(-6px); }
	to { opacity: 1; transform: none; }
}

@keyframes ports-fly-in-left {
	from { opacity: 0; transform: translateX(6px); }
	to { opacity: 1; transform: none; }
}

.ports-fly-head {
	padding: 3px 8px 5px;
	font-size: 11px;
	letter-spacing: 0.04em;
	color: <<colour muted-foreground>>;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.ports-port {
	display: grid;
	grid-template-columns: 18px auto minmax(0, 1fr) 12px;
	gap: 8px;
	align-items: center;
	padding: 5px 6px 5px 8px;
	border-radius: 7px;
	cursor: grab;
	touch-action: none;
	user-select: none;
	transition: background-color 0.12s;
}

.ports-port:hover,
.ports-port.is-source {
	background: <<colour tiddler-editor-background>>;
}

.ports-ico {
	text-align: center;
	font-size: 13px;
}

.ports-cap {
	font-weight: 500;
	white-space: nowrap;
}

.ports-val {
	text-align: right;
	font-size: 12.5px;
	color: <<colour muted-foreground>>;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.ports-n {
	display: inline-block;
	min-width: 18px;
	margin-left: 4px;
	padding: 0 5px;
	border-radius: 999px;
	background: <<colour tiddler-editor-background>>;
	color: <<colour primary>>;
	font-size: 11px;
	text-align: center;
	font-variant-numeric: tabular-nums;
}

.ports-hint {
	font-style: italic;
	opacity: 0.8;
}

.ports-dot {
	width: 10px;
	height: 10px;
	box-sizing: border-box;
	border-radius: 50%;
	border: 1.5px solid <<colour muted-foreground>>;
	background: <<colour tiddler-background>>;
	transition: transform 0.12s, background-color 0.12s, border-color 0.12s;
}

.ports-port.is-filled .ports-dot {
	background: <<colour primary>>;
	border-color: <<colour primary>>;
}

.ports-port:hover .ports-dot,
.ports-port.is-source .ports-dot {
	transform: scale(1.3);
	border-color: <<colour primary>>;
}

.ports-chips {
	display: grid;
	margin: 0 6px 4px 31px;
	border-left: 1.5px solid <<colour tiddler-border>>;
}

.ports-chip {
	display: flex;
	align-items: center;
	gap: 6px;
	padding: 2px 4px 2px 10px;
	border-radius: 0 5px 5px 0;
	font-size: 12.5px;
}

.ports-chip:hover {
	background: <<colour tiddler-editor-background>>;
}

.ports-flyout a.ports-chip-go {
	flex: 1;
	min-width: 0;
	color: <<colour foreground>>;
	font-weight: normal;
	text-decoration: none;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.ports-flyout a.ports-chip-go:hover {
	color: <<colour primary>>;
}

.ports-flyout .ports-chip-x {
	width: 20px;
	height: 20px;
	border-radius: 4px;
	color: <<colour muted-foreground>>;
	opacity: 0;
	transition: opacity 0.12s;
}

.ports-chip:hover .ports-chip-x,
.ports-flyout .ports-chip-x:focus-visible {
	opacity: 1;
}

.ports-flyout .ports-chip-x:hover {
	color: <<colour alert-highlight>>;
}

.ports-flyout .ports-more {
	display: block;
	width: 100%;
	margin-top: 4px;
	padding: 5px 8px 3px;
	border-top: 1px solid <<colour tiddler-border>>;
	text-align: left;
	font-size: 12px;
	color: <<colour muted-foreground>>;
}

.ports-flyout .ports-more:hover {
	color: <<colour primary>>;
}

/* ---------- drag targets ---------- */

.ports-dragging,
.ports-dragging * {
	cursor: grabbing;
	user-select: none;
}

.tc-tiddler-frame.ports-valid {
	outline: 1.5px dashed <<colour primary>>;
	outline-offset: 4px;
}

.tc-tiddler-frame.ports-hover,
.tc-tiddler-frame.ports-peek {
	outline: 1.5px solid <<colour primary>>;
	outline-offset: 4px;
}

/* Bridges style their own target elements with .ports-valid / .ports-hover / .ports-peek */

/* ---------- wires ---------- */

.ports-wires {
	position: fixed;
	inset: 0;
	width: 100%;
	height: 100%;
	z-index: 1040;
	pointer-events: none;
	overflow: visible;
}

.ports-wire {
	fill: none;
	stroke: <<colour primary>>;
	stroke-width: 1.75;
	stroke-linecap: round;
}

.ports-wire--peek {
	opacity: 0.5;
}

.ports-wire--drag {
	opacity: 0.7;
	stroke-dasharray: 5 5;
}

.ports-wire--drag.is-snapped {
	opacity: 1;
	stroke-dasharray: none;
	stroke-width: 2;
}

.ports-wire-end {
	fill: <<colour primary>>;
}

/* ---------- dock ---------- */

.ports-dock {
	position: fixed;
	top: 0;
	right: 0;
	bottom: 0;
	z-index: 1030;
	display: flex;
	width: 22px;
	box-sizing: border-box;
	background: <<colour tiddler-background>>;
	border-left: 1px solid <<colour tiddler-border>>;
	color: <<colour foreground>>;
	font-size: 13.5px;
	line-height: 1.4;
	transition: width 0.2s ease, box-shadow 0.2s;
}

.ports-dock.is-open {
	width: min(310px, 88vw);
	box-shadow: -10px 0 30px rgba(0, 0, 0, 0.16);
}

.ports-dock .ports-dock-strip {
	flex: none;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 10px;
	width: 22px;
	padding-top: 16px;
	color: <<colour muted-foreground>>;
}

.ports-dock .ports-dock-strip:hover {
	color: <<colour primary>>;
}

.ports-dock-strip-ico {
	width: 10px;
	height: 10px;
	box-sizing: border-box;
	border-radius: 50%;
	border: 1.5px solid currentColor;
}

.ports-dock-strip-label {
	writing-mode: vertical-rl;
	font-size: 10.5px;
	letter-spacing: 0.14em;
	text-transform: uppercase;
}

.ports-dock-panel {
	display: none;
	flex: 1;
	min-width: 0;
	flex-direction: column;
	gap: 10px;
	padding: 16px 12px 12px 6px;
}

.ports-dock.is-open .ports-dock-panel {
	display: flex;
}

.ports-eyebrow,
.ports-sec {
	font-size: 10.5px;
	letter-spacing: 0.12em;
	text-transform: uppercase;
	color: <<colour muted-foreground>>;
}

.ports-sec {
	padding: 10px 8px 3px;
}

.ports-dock-title {
	margin-top: 2px;
	font-size: 17px;
	font-weight: 500;
}

.ports-dock-sub {
	margin-top: 2px;
	font-size: 12px;
	color: <<colour muted-foreground>>;
}

.ports-dock .ports-search {
	box-sizing: border-box;
	width: 100%;
	padding: 6px 9px;
	border-radius: 6px;
	border: 1px solid <<colour tiddler-border>>;
	background: <<colour tiddler-editor-background>>;
	color: <<colour foreground>>;
	font-size: 13px;
}

.ports-search.is-live {
	border-color: <<colour primary>>;
}

.ports-search.is-empty {
	color: <<colour muted-foreground>>;
}

.ports-dock-list {
	flex: 1;
	min-height: 0;
	overflow-y: auto;
	display: flex;
	flex-direction: column;
	gap: 2px;
}

.ports-tile {
	display: grid;
	grid-template-columns: 20px minmax(0, 1fr) auto;
	gap: 8px;
	align-items: center;
	padding: 6px 8px;
	border-radius: 7px;
	border: 1px solid transparent;
	transition: background-color 0.12s, border-color 0.12s;
}

.ports-tile:hover,
.ports-tile.ports-hover,
.ports-tile.ports-peek {
	background: <<colour tiddler-editor-background>>;
	border-color: <<colour primary>>;
}

.ports-tile.is-linked {
	opacity: 0.55;
}

.ports-tile-cap {
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.ports-tile-meta {
	font-size: 11px;
	color: <<colour muted-foreground>>;
}

.ports-empty {
	padding: 10px 8px;
	font-size: 12.5px;
	color: <<colour muted-foreground>>;
}

.ports-dock-foot {
	padding-top: 8px;
	border-top: 1px solid <<colour tiddler-border>>;
	font-size: 11px;
	color: <<colour muted-foreground>>;
}

@media (prefers-reduced-motion: reduce) {
	.ports-flyout {
		animation: none;
	}
	.ports-handle,
	.ports-ring,
	.ports-port,
	.ports-dot,
	.ports-dock,
	.ports-tile,
	.ports-chip-x {
		transition: none;
	}
}
